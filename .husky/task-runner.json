{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "tasks": [
      {
         "name": "dotnet-format",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [ "format", "whitespace", "ElRoso.Commons.sln", "--verify-no-changes" ]
      },
      {
         "name": "dotnet-build",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [ "build", "ElRoso.Commons.sln", "-c", "Release", "--nologo" ]
      },
      {
         "name": "dotnet-test",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [ "test", "Tests/ElRoso.Commons.Tests.csproj", "--nologo", "--no-build", "-c", "Release" ]
      }
   ]
}
