<Project Sdk="Microsoft.NET.Sdk.Web">

	<!-- Consumidor del OpenAPI nativo: genera un documento por versión al compilar. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
		<OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/openapi</OpenApiDocumentsDirectory>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\ElRoso.Commons.AspNetCore\ElRoso.Commons.AspNetCore.csproj" />
		<ProjectReference Include="..\..\src\ElRoso.Commons.OpenApi\ElRoso.Commons.OpenApi.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
	</ItemGroup>

</Project>
