<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Version>1.0.3</Version>
		<Description>Logging con Serilog: consola, archivo, Seq y Graylog, con el log de Hosting.Diagnostics silenciado bajo Warning.</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\ElRoso.Commons.Core\ElRoso.Commons.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Serilog" />
		<PackageReference Include="Serilog.AspNetCore" />
		<PackageReference Include="Serilog.Enrichers.Environment" />
		<PackageReference Include="Serilog.Enrichers.Thread" />
		<PackageReference Include="Serilog.Sinks.Graylog" />
		<PackageReference Include="Serilog.Sinks.Seq" />
	</ItemGroup>

</Project>
